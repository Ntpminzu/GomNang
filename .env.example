# GOM NẮNG - biến môi trường mẫu.
# Chép thành .env và điền giá trị thật. KHÔNG commit file .env.

# ---- LLM (dùng cho smoke test tuần 2 và tính năng AI từ tuần 6) ----
# gemini | anthropic | openai | ollama
LLM_PROVIDER=gemini
LLM_MODEL=
# Chỉ điền key của provider đang dùng.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Endpoint tương thích OpenAI (Groq, vLLM của lớp, ...). Bỏ trống nếu dùng OpenAI chính thức.
OPENAI_BASE_URL=
# Ollama chạy cục bộ.
OLLAMA_BASE_URL=http://localhost:11434

# ---- Backend (từ tuần 4) ----
PORT=3000
NODE_ENV=development
DATABASE_URL=
# Xác thực: Supabase Auth phát JWT, backend kiểm tra chữ ký qua JWKS.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# ---- Lưu trữ ảnh bằng chứng (từ tuần 4) ----
STORAGE_BUCKET_PUBLIC=gomnang-public
STORAGE_BUCKET_PRIVATE=gomnang-private

# ---- Frontend (từ tuần 3) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
