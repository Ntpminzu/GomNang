# Biến cho script ở thư mục gốc (scripts/llm-smoke-test.mjs).
# Chép thành .env và điền giá trị thật. KHÔNG commit file .env.
#
# Biến của backend nằm ở be/.env.example.

# gemini | anthropic | openai | ollama
LLM_PROVIDER=gemini
LLM_MODEL=
# Chỉ điền key của provider đang dùng.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Endpoint tương thích OpenAI (Groq, vLLM của lớp, ...). Bỏ trống nếu dùng OpenAI chính thức.
OPENAI_BASE_URL=
# Ollama chạy cục bộ.
OLLAMA_BASE_URL=http://localhost:11434
