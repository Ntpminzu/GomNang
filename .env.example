# Biến cho thư mục gốc repo: Docker Compose và script LLM smoke test.
# Chép thành .env và điền giá trị thật. KHÔNG commit file .env.
#
# Biến của backend khi chạy `npm run dev:be` nằm ở be/.env.example.
# Biến của frontend nằm ở fe/.env.example.

# ---- Docker Compose (docker compose up) ----
# Khoá ký JWT cho backend chạy trong container, ít nhất 32 ký tự. Tạo bằng:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Ollama trên máy host, nhìn từ trong container (mặc định cổng 11434). Đổi nếu chạy Ollama cổng khác.
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
# Máy yếu (Ollama chạy CPU) đặt false để chat bỏ phần suy nghĩ dài, trả lời nhanh hơn.
OLLAMA_CHAT_THINK=true

# Tài khoản thử có mật khẩu do service "init" tạo (bỏ trống thì không tạo). Mật khẩu tự đặt, ≥ 8 ký tự, không dùng mật khẩu thật.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_VERIFIER_EMAIL=
DEMO_VERIFIER_PASSWORD=

# ---- LLM smoke test (scripts/llm-smoke-test.mjs) ----
# Chỉ Qwen qua Ollama; dùng cùng cấu hình với backend.
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
