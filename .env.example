# Biến cho thư mục gốc repo: Docker Compose và script LLM smoke test.
# Chép thành .env và điền giá trị thật. KHÔNG commit file .env.
#
# Biến của backend khi chạy `npm run dev:be` nằm ở be/.env.example.
# Biến của frontend nằm ở fe/.env.example.

# ---- Docker Compose (docker compose up) ----
# Khoá ký JWT cho backend chạy trong container, ít nhất 32 ký tự. Tạo bằng:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- LLM smoke test (scripts/llm-smoke-test.mjs) ----
# Chỉ Qwen qua Ollama; dùng cùng cấu hình với backend.
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
