# Biến cho thư mục gốc repo: Docker Compose và script LLM smoke test.
# Chép thành .env và điền giá trị thật. KHÔNG commit file .env.
#
# Biến của backend khi chạy `npm run dev:backend` nằm ở backend/.env.example.
# Biến của frontend nằm ở frontend/.env.example.

# ---- Docker Compose (docker compose up) ----
# Khoá ký JWT cho backend chạy trong container. Tạo bằng:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- LLM smoke test (scripts/llm-smoke-test.mjs) ----
# gemini | anthropic | openai | ollama
LLM_PROVIDER=gemini
LLM_MODEL=
# Chỉ điền key của provider đang dùng.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Endpoint tương thích OpenAI (Groq, vLLM của lớp, ...). Bỏ trống nếu dùng OpenAI chính thức.
OPENAI_BASE_URL=
# Ollama chạy cục bộ.
OLLAMA_BASE_URL=http://localhost:11434
