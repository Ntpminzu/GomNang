{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    // Node chạy thẳng file .ts bằng cách xoá phần kiểu — ba cờ dưới bắt tsc báo lỗi
    // nếu viết cú pháp mà Node không xoá được (enum, namespace, parameter property...).
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "test", "scripts", "drizzle.config.ts"]
}
