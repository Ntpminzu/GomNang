# Backend GOM NẮNG — chép thành .env (cùng thư mục) rồi điền giá trị. KHÔNG commit file .env.

PORT=4000
NODE_ENV=development

# Chuỗi ngẫu nhiên dài ít nhất 32 ký tự, dùng để ký JWT. Tạo bằng lệnh:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Server từ chối khởi động nếu thiếu.
JWT_SECRET=

# ---- Database: chọn MỘT trong hai ----
# (1) Bỏ trống DATABASE_URL → dùng PGlite (PostgreSQL nhúng) lưu ở DATA_DIR. Mặc định khi dev, không cần cài gì.
#     Xoá thư mục này = xoá sạch dữ liệu (npm run db:reset).
DATA_DIR=.data/pglite
# (2) Điền DATABASE_URL → dùng PostgreSQL thật (Docker Compose, Supabase).
#     Mặc định luôn bật TLS. Thêm ?sslmode=disable vào cuối URL để tắt — chỉ dùng cho Postgres chạy local.
#     Supabase: lấy chuỗi "Session pooler" trong nút Connect của dashboard (chạy được trên mạng chỉ có IPv4).
DATABASE_URL=
# Chứng chỉ CA dạng PEM để kiểm chứng máy chủ Postgres. Bỏ trống thì vẫn mã hoá nhưng không kiểm chứng.
DATABASE_CA_CERT=

# Đăng nhập bằng tài khoản mẫu (POST /api/auth/dev-login). Đặt false để tắt.
ENABLE_DEV_LOGIN=true
# Khi NODE_ENV=production, đăng nhập mẫu bị tắt — trừ khi biến này đúng bằng true.
# Bật = ai có link cũng đăng nhập được thành tài khoản mẫu. Chỉ dùng cho bản demo toàn dữ liệu giả.
ALLOW_DEMO_LOGIN_IN_PRODUCTION=false

# Tự nạp dữ liệu mẫu khi database còn trống.
SEED_ON_EMPTY=true

# Origin của web được phép gọi API từ trình duyệt, cách nhau bằng dấu phẩy, không có dấu / ở cuối.
CORS_ORIGINS=http://localhost:3000
