{
  "name": "gomnang-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:us1": "node scripts/dev-us1.ts",
    "db:prepare:us1": "node scripts/prepare-us1.ts",
    "auth:bootstrap-admin": "node scripts/bootstrap-admin.ts",
    "db:deploy:us1": "node --env-file-if-exists=.env scripts/deploy-us1-schema.ts",
    "db:deploy:us7": "node --env-file-if-exists=.env scripts/deploy-us7-schema.ts",
    "rag:index": "node --env-file-if-exists=.env scripts/index-chat.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "sql": "node --env-file-if-exists=.env scripts/sql.ts",
    "db:transfer": "node --env-file-if-exists=.env scripts/migrate-to-supabase.ts",
    "db:seed-projects": "node --env-file-if-exists=.env scripts/seed-projects.ts",
    "db:generate": "drizzle-kit generate",
    "db:reset": "node -e \"require('node:fs').rmSync('.data', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@gomnang/domain": "*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/proper-lockfile": "^4.1.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
