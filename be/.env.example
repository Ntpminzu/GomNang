# Backend GOM NẮNG — chép thành .env (cùng thư mục) rồi điền giá trị. KHÔNG commit file .env.

PORT=4000
NODE_ENV=development

# Chuỗi ngẫu nhiên dài ít nhất 32 ký tự, dùng để ký JWT. Tạo bằng lệnh:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Server từ chối khởi động nếu thiếu.
JWT_SECRET=

# Thư mục lưu PostgreSQL nhúng (PGlite). Xoá thư mục này = xoá sạch dữ liệu (npm run db:reset).
DATA_DIR=.data/pglite

# Có DATABASE_URL: dùng PostgreSQL/Supabase. Bỏ trống: dùng PGlite local.
# Lấy Session pooler trong Supabase > Connect. Mật khẩu phải URL-encode.
DATABASE_URL=

# Đăng nhập giả bằng email để thử nghiệm. Luôn bị tắt khi NODE_ENV=production, bất kể giá trị ở đây.
ENABLE_DEV_LOGIN=true

# Tự nạp dữ liệu mẫu khi database còn trống.
SEED_ON_EMPTY=true

# Chatbot local. Ollama chạy trên cùng máy với backend; tải hai model trước:
#   ollama pull qwen3:4b
#   ollama pull qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Tuỳ chọn: bật Gemini trong hộp chat. Chỉ backend đọc key này; không dùng NEXT_PUBLIC_ và không commit be/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
